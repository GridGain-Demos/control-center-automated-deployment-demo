# Control Center Automated Deployment - Environment Variables
#
# Copy this file to .env and update the values:
#   cp .env.example .env

# =============================================================================
# Required Variables
# =============================================================================

# Control Center base URL(usually, the address used to open Control Center in browser)
CC_BASE_URL=http://localhost:8008

# Admin credentials
CC_ADMIN_EMAIL=admin@example.com
CC_ADMIN_PASSWORD=your-secure-password

# =============================================================================
# Optional Variables
# =============================================================================

# Health check timeout in seconds (default: 300)
CC_HEALTH_TIMEOUT=300

# Connector availability timeout in seconds (default: 120)
CC_CONNECTOR_TIMEOUT=120

# Enable dry-run mode (default: false)
# Set to 'true' to preview changes without applying them
CC_DRY_RUN=false
